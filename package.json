{
  "name": "job-loader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A local XML job feed importer with persistent JSON storage",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build --silent && node dist/cli.js",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:greenhouse:live": "npm run build --silent && node --env-file=test.env test/greenhouse.live.mjs",
    "format": "prettier --write src test README.md package.json tsconfig.json",
    "fun": "npm run build --silent && node dist/fun.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}
